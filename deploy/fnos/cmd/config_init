#!/bin/bash
# Navi · 应用设置变更前检查
#
# 设置页提交的是访问密码/站点标题等，没有需要预校验的破坏性动作，
# 这里只做一次输入合法性复核：密码要么没改，要么给足长度。
#
# 向导字段兼容两种命名：wizard_navi_xxx（当前，官方建议的 wizard_ 前缀）与 navi_xxx（早期版本）。
LOG="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
PW="${wizard_navi_password:-${navi_password:-}}"

if [ -n "$PW" ] && [ "${#PW}" -lt 6 ]; then
    echo "访问密码至少 6 位，请重新填写。" >> "$LOG"
    exit 1
fi

exit 0

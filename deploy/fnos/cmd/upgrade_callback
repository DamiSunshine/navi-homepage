#!/bin/bash
# Navi · 升级后收尾
#
# 升级只会替换 app/（包内文件），${TRIM_PKGVAR} 里的数据与环境文件本应原样保留。
# 但"本应"不等于"一定"：只要其中任何一样丢了，新版本就会起不来或者起成无鉴权站点。
# 所以这里逐项兜底，宁可少跑一次也要把状态补齐。
LOG="${TRIM_TEMP_LOGFILE:-/dev/stderr}"
APPNAME="${TRIM_APPNAME:-navi}"
VAR_DIR="${TRIM_PKGVAR:-/var/apps/${APPNAME}/var}"
APPDEST="${TRIM_APPDEST:-/var/apps/${APPNAME}/target}"
DATA_DIR="${VAR_DIR}/data"
ENV_FILE="${VAR_DIR}/navi.env"
BOOTSTRAP="${APPDEST}/docker/bootstrap/config.json"

mkdir -p "$DATA_DIR/uploads" 2>/dev/null

# ① 配置缺失：用包内模板补一份（老配置若还在则完全不动）
if [ ! -f "${DATA_DIR}/config.json" ]; then
    if [ -f "$BOOTSTRAP" ]; then
        cp "$BOOTSTRAP" "${DATA_DIR}/config.json" 2>/dev/null
        echo "原配置缺失，已用初始模板重建：${DATA_DIR}/config.json" > "$LOG"
    else
        echo "数据目录缺少 config.json 且包内没有模板，站点将无法启动。" > "$LOG"
        exit 1
    fi
fi

# ② 环境文件缺失：优先用向导值；向导没给就生成随机密码并留一份明文到数据目录，
#    绝不为了"能起来"而写出空密码 —— 那等于关掉鉴权。
if [ ! -f "$ENV_FILE" ]; then
    umask 077
    if [ -n "${navi_password:-}" ]; then
        {
            echo "NAVI_PASSWORD=${navi_password}"
            [ -n "${navi_site_title:-}" ] && echo "SITE_TITLE=${navi_site_title}"
            [ -n "${navi_site_subtitle:-}" ] && echo "SITE_SUBTITLE=${navi_site_subtitle}"
            [ -n "${navi_lan_host:-}" ] && echo "NAVI_LAN_HOST=${navi_lan_host}"
        } > "$ENV_FILE"
        chmod 600 "$ENV_FILE"
        echo "环境变量文件缺失，已按向导值重建：${ENV_FILE}" > "$LOG"
    else
        NEW_PW="$( { date +%s%N; cat /proc/sys/kernel/random/uuid 2>/dev/null; } | sha256sum | cut -c1-16 )"
        {
            echo "NAVI_PASSWORD=${NEW_PW}"
            [ -n "${navi_site_title:-}" ] && echo "SITE_TITLE=${navi_site_title}"
        } > "$ENV_FILE"
        chmod 600 "$ENV_FILE"
        echo "$NEW_PW" > "${DATA_DIR}/PASSWORD.txt"
        chmod 600 "${DATA_DIR}/PASSWORD.txt"
        echo "环境变量文件缺失且向导未提供密码，已生成随机密码并保存到 ${DATA_DIR}/PASSWORD.txt，请及时修改。" > "$LOG"
    fi
fi

exit 0

# ============================================================
# Navi 环境变量示例
#   用法：cp .env.example .env  然后编辑 .env 填入真实值
#   本文件会随仓库提交（不含任何真实密钥）；.env 已被 gitignore 排除
# ============================================================

# ---- 必填：访问密码 ----
# 不设置或留空会导致认证功能关闭，站点变为「任何人可访问 + 可编辑」。
# 暴露公网前请务必设置一个强密码。
NAVI_PASSWORD=CHANGE_ME

# ---- 可选：登录用户名 ----
# 设置后登录必须同时输入正确的用户名 + 密码；不设置则仅校验密码。
# NAVI_USERNAME=admin

# ---- 可选：用哈希替代明文密码（更推荐） ----
# 注意：服务端比对的是 sha256("navi-site:" + 密码)，必须带 navi-site: 前缀；
# 直接用裸 sha256 会永远登录失败（401 且无报错）。生成方式：
#   node -e "console.log(require('crypto').createHash('sha256').update('navi-site:'+process.argv[1]).digest('hex'))" '你的密码'
# 若填了 NAVI_PASSWORD_HASH，可删除上面的 NAVI_PASSWORD 行。
# NAVI_PASSWORD_HASH=

# ---- 可选：会话有效期（小时），默认 72 ----
# SESSION_TTL_HOURS=72

# ---- 可选：发布到 GitHub 用的访问令牌（仅 scripts/publish-github.cjs 读取） ----
# 这是「访问令牌」不是登录密码：GitHub 自 2021 年起不再接受账号密码做 git 操作。
# 生成：GitHub → 头像 → Settings → Developer settings → Personal access tokens
#       → Fine-grained tokens → 勾选目标仓库 → Contents 设为 Read and write
# 只需填在 .env（已被 gitignore 排除）；服务端运行时完全不用它，
# 也不会被 compose 注入容器（compose 只替换 environment: 中显式引用的变量）。
# GH_TOKEN=

# ---- 可选：服务发现 ----
# 挂载 /var/run/docker.sock 后启用「自动识别容器 + 匹配图标 + 生成卡片」
# DOCKER_SOCKET=/var/run/docker.sock
# 也可改用远程 Docker API（TCP）而不用挂 socket
# DOCKER_HOST_NAME=192.168.1.10
# DOCKER_HOST_PORT=2375
# 内网 / 外网地址基址（不设则自动探测；外网不设时用内网地址兜底）
# NAVI_LAN_HOST=192.168.1.10
# NAVI_WAN_HOST=nav.example.com
# 离线环境建议关闭图标在线探测，加快扫描速度
# NAVI_ICON_PROBE=0
